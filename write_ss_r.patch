diff --git a/src/postw90/get_oper.F90 b/src/postw90/get_oper.F90
index 8230135..6782bfe 100644
--- a/src/postw90/get_oper.F90
+++ b/src/postw90/get_oper.F90
@@ -956,22 +956,26 @@ contains
     !
     !================================================================
 
-    use w90_constants, only: dp, pi, cmplx_0
-    use w90_parameters, only: num_wann, ndimwin, num_kpts, num_bands, &
-      timing_level, have_disentangled, spn_formatted
-    use w90_postw90_common, only: nrpts, v_matrix
+    use w90_constants, only: dp, pi, twopi, cmplx_0, cmplx_i
+    use w90_parameters, only: num_wann, ndimwin, num_kpts, kpt_latt, num_bands, &
+      timing_level, have_disentangled, spn_formatted, write_ss_r, &
+      m_matrix, wb, bk, nntot
+    use w90_postw90_common, only: nrpts, v_matrix, irvec, ndegen
     use w90_io, only: io_error, io_stopwatch, stdout, seedname, &
-      io_file_unit
+      io_date, io_file_unit
     use w90_comms, only: on_root, comms_bcast
 
     implicit none
 
     complex(kind=dp), allocatable :: spn_o(:, :, :, :), SS_q(:, :, :, :), spn_temp(:, :)
-    real(kind=dp)                 :: s_real, s_img
+    real(kind=dp)                 :: s_real, s_img, rdotk
     integer, allocatable          :: num_states(:)
-    integer                       :: i, j, ii, jj, m, n, spn_in, ik, is, &
-                                     winmin, nb_tmp, nkp_tmp, ierr, s, counter
+    integer                       :: i, j, irpt, ii, jj, m, n, spn_in, ik, is, &
+                                     nn, idir, winmin, nb_tmp, nkp_tmp, ierr, &
+                                     s, counter, file_unit, ir
     character(len=60)             :: header
+    character(len=9)              :: cdate, ctime
+    complex(kind=dp)              :: fac, pos_r(3)
 
     if (timing_level > 1 .and. on_root) call io_stopwatch('get_oper: get_SS_R', 1)
 
@@ -1077,6 +1081,63 @@ contains
       call fourier_q_to_R(SS_q(:, :, :, 2), SS_R(:, :, :, 2))
       call fourier_q_to_R(SS_q(:, :, :, 3), SS_R(:, :, :, 3))
 
+      ! Write SS_R to file only when explicitly requested in the input file
+      if (write_ss_r) then
+        file_unit = io_file_unit()
+        open (unit=file_unit, file=trim(seedname)//'_SS_R.dat', &
+              form='formatted', status='unknown', iostat=ierr)
+        if (ierr /= 0) then
+          write (stdout, *) 'Error opening file '//trim(seedname)//'_SS_R.dat'
+          call io_error('Failed to open output file')
+        end if
+
+        call io_date(cdate, ctime)
+        header = 'written on '//cdate//' at '//ctime
+        write (file_unit, *) header
+        write (file_unit, *) num_wann
+        write (file_unit, *) nrpts
+        write (file_unit, '(15I4)') (ndegen(i), i=1, nrpts)
+
+        ! Write the three components of SS_R
+        do ir = 1, nrpts
+          write (file_unit, '(/,3I4)') irvec(:, ir)
+          do i = 1, num_wann
+            do j = 1, num_wann
+              write (file_unit, '(2I4,3x,6(E16.9,1x))') j, i, &
+                (real(SS_R(j, i, ir, is)), aimag(SS_R(j, i, ir, is)), is=1, 3)
+            end do
+          end do
+        end do
+
+        ! Write <0n|r|Rm>, preserving the existing SS_R.dat layout
+        do irpt = 1, nrpts
+          write (file_unit, '(/,3I4)') irvec(:, irpt)
+          do i = 1, num_wann
+            do j = 1, num_wann
+              pos_r(:) = 0.0_dp
+              do ik = 1, num_kpts
+                rdotk = twopi*dot_product(kpt_latt(:, ik), real(irvec(:, irpt), dp))
+                fac = exp(-cmplx_i*rdotk)/real(num_kpts, dp)
+                do idir = 1, 3
+                  do nn = 1, nntot
+                    if (i == j) then
+                      pos_r(idir) = pos_r(idir) - &
+                        wb(nn)*bk(idir, nn, ik)* &
+                        aimag(log(m_matrix(i, i, nn, ik)))*fac
+                    else
+                      pos_r(idir) = pos_r(idir) + cmplx_i*wb(nn)* &
+                        bk(idir, nn, ik)*m_matrix(j, i, nn, ik)*fac
+                    end if
+                  end do
+                end do
+              end do
+              write (file_unit, '(2I4,3x,6(E15.8,1x))') j, i, pos_r(:)
+            end do
+          end do
+        end do
+        close (file_unit)
+      end if
+
     endif !on_root
 
     call comms_bcast(SS_R(1, 1, 1, 1), num_wann*num_wann*nrpts*3)
